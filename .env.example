# Supabase connection
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=

# Manager Authorization Allowlist (Optional comma-separated list of authorized manager emails)
# Example: ADMIN_ALLOWED_EMAILS=manager1@akshara.com,manager2@akshara.com
ADMIN_ALLOWED_EMAILS=

# Cron Job Authentication Secret (Optional secret for /api/send-fee-reminders)
CRON_SECRET=

# WhatsApp Cloud API (Edge Function / Server secrets only - NEVER commit real tokens)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_FEE_TEMPLATE_NAME=fee_reminder_v1
WHATSAPP_RECEIPT_TEMPLATE_NAME=payment_receipt_v1
WHATSAPP_DRY_RUN=true
WHATSAPP_GRAPH_API_VERSION=v21.0
